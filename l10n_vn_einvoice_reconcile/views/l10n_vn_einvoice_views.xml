<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_vn_einvoice_view_form" model="ir.ui.view">
        <field name="name">l10n_vn.einvoice.form.reconcile</field>
        <field name="model">l10n_vn.einvoice</field>
        <field name="inherit_id" ref="l10n_vn_einvoice.l10n_vn_einvoice_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook invisible="not portal_ids"
                          groups="account.group_account_readonly,account.group_account_manager">
                    <page string="Portal" name="portal">
                        <field name="portal_ids" readonly="1">
                            <list>
                                <field name="batch_id"/>
                                <field name="status_kind"/>
                                <field name="match_state"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
