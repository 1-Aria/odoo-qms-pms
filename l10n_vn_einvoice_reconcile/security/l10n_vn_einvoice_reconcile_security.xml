<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_vn_einvoice_batch_company_rule" model="ir.rule">
        <field name="name">E-invoice portal lists: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_einvoice_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="l10n_vn_einvoice_portal_row_company_rule" model="ir.rule">
        <field name="name">E-invoice portal rows: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_einvoice_portal_row"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="l10n_vn_einvoice_portal_company_rule" model="ir.rule">
        <field name="name">E-invoices on the portal: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_einvoice_portal"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
