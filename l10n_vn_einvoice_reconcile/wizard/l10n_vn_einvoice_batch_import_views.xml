<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_vn_einvoice_batch_import_view_form" model="ir.ui.view">
        <field name="name">l10n_vn.einvoice.batch.import.form</field>
        <field name="model">l10n_vn.einvoice.batch.import</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="batch_id"/>
                    <field name="list_kind"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <p class="text-muted">
                    The file is read into rows and not kept. Importing again replaces the list's rows.
                </p>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="l10n_vn_einvoice_batch_import_action" model="ir.actions.act_window">
        <field name="name">Import Portal List</field>
        <field name="res_model">l10n_vn.einvoice.batch.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
