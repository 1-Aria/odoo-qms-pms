<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_vn_einvoice_tax_view_list" model="ir.ui.view">
        <field name="name">l10n_vn.einvoice.tax.list</field>
        <field name="model">l10n_vn.einvoice.tax</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="tax_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="l10n_vn_einvoice_tax_action" model="ir.actions.act_window">
        <field name="name">E-Invoice VAT Codes</field>
        <field name="res_model">l10n_vn.einvoice.tax</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Map the e-invoice VAT codes to taxes</p>
            <p>One row per code written in an e-invoice's TSuat (0%, 5%, 8%, 10%, KCT,
                KKKNT…), naming the purchase tax its lines take. Leave the tax empty for a
                code that carries no VAT.</p>
        </field>
    </record>

    <menuitem id="l10n_vn_einvoice_tax_menu"
              name="E-Invoice VAT Codes"
              parent="account.account_account_menu"
              action="l10n_vn_einvoice_tax_action"
              sequence="3"/>
</odoo>
