<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_vn_einvoice_company_rule" model="ir.rule">
        <field name="name">E-invoices: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_einvoice"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="l10n_vn_einvoice_tax_company_rule" model="ir.rule">
        <field name="name">E-invoice VAT codes: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_einvoice_tax"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
