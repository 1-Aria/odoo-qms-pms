<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The company's components consumed by orders with an owner: the register of
         material to invoice to the owner. -->
    <record id="action_processing_material" model="ir.actions.act_window">
        <field name="name">Company Material in Processing</field>
        <field name="res_model">stock.valuation.layer</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain">[('stock_move_id.raw_material_production_id.owner_id', '!=', False), ('stock_move_id.raw_material_production_id.production_owned', '=', True)]</field>
        <field name="context">{'search_default_group_by_product_id': 1}</field>
        <field name="search_view_id" ref="stock_account.view_inventory_valuation_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('stock_account.stock_valuation_layer_tree')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('stock_account.stock_valuation_layer_pivot')})]"/>
    </record>

    <record id="view_processed_goods_pivot" model="ir.ui.view">
        <field name="name">stock.move.pivot.processed_goods</field>
        <field name="model">stock.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <pivot string="Processed Goods">
                <field name="product_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Goods produced by orders with an owner: the quantities of the processing fees. -->
    <record id="action_processed_goods" model="ir.actions.act_window">
        <field name="name">Processed Goods</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[('production_id.owner_id', '!=', False), ('production_id.production_owned', '=', True), ('state', '=', 'done')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_processed_goods_pivot')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('stock.view_move_tree')})]"/>
    </record>

    <menuitem id="menu_processing_material"
              name="Company Material in Processing"
              parent="mrp.menu_mrp_reporting"
              action="action_processing_material"
              groups="stock.group_stock_manager"
              sequence="40"/>
    <menuitem id="menu_processed_goods"
              name="Processed Goods"
              parent="mrp.menu_mrp_reporting"
              action="action_processed_goods"
              groups="mrp.group_mrp_manager"
              sequence="41"/>
</odoo>
