<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp.production.form.partner_owner</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='miscellaneous']//field[@name='picking_type_id']" position="after">
                <field name="owner_id" readonly="state not in ('draft', 'confirmed')"/>
                <field name="production_owned" readonly="state not in ('draft', 'confirmed')" invisible="not owner_id"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_tree_view" model="ir.ui.view">
        <field name="name">mrp.production.list.partner_owner</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="owner_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_production_filter" model="ir.ui.view">
        <field name="name">mrp.production.search.partner_owner</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field name="owner_id"/>
            </xpath>
            <xpath expr="//filter[@name='filter_cancel']" position="after">
                <separator/>
                <filter string="Processing" name="filter_processing" domain="[('owner_id', '!=', False)]"/>
                <filter string="Own Production" name="filter_own_production" domain="[('owner_id', '=', False)]"/>
            </xpath>
            <xpath expr="//filter[@name='procurement_group_id']" position="after">
                <filter string="Goods Owner" name="group_by_owner_id" context="{'group_by': 'owner_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
