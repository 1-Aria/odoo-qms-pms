<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.l10n_vn_voucher</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='misc_group']" position="inside">
                <field name="l10n_vn_journal_type" invisible="1"/>
                <field name="l10n_vn_voucher_kind" invisible="1"/>
                <field name="l10n_vn_voucher_number" invisible="not l10n_vn_voucher_number"/>
                <field name="l10n_vn_voucher_person" invisible="l10n_vn_journal_type != 'cash'"/>
                <field name="l10n_vn_voucher_address" invisible="l10n_vn_journal_type != 'cash'"/>
            </xpath>
        </field>
    </record>
</odoo>
