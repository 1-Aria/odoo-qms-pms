<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="rule_advance_company" model="ir.rule">
        <field name="name">Salary advance: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_payroll_advance" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_advance_batch_company" model="ir.rule">
        <field name="name">Salary advance batch: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_payroll_advance_batch" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_advance_settlement_company" model="ir.rule">
        <field name="name">Salary advance settlement: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_payroll_advance_settlement" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
