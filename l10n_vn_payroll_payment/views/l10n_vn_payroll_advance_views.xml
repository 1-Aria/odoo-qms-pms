<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_vn_payroll_advance_view_list" model="ir.ui.view">
        <field name="name">l10n_vn.payroll.advance.list</field>
        <field name="model">l10n_vn.payroll.advance</field>
        <field name="arch" type="xml">
            <list
                decoration-warning="over_limit and state == 'draft'"
                decoration-muted="state == 'cancelled'"
            >
                <header>
                    <button
                        name="action_approve"
                        type="object"
                        string="Approve"
                        groups="l10n_vn_payroll.group_payroll_reviewer"
                    />
                    <button
                        name="action_create_payment"
                        type="object"
                        string="Create Payment List"
                        groups="payroll.group_payroll_user"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        groups="payroll.group_payroll_user"
                    />
                </header>
                <field name="employee_id" />
                <field name="date" />
                <field name="amount" sum="Total" />
                <field name="reason" />
                <field name="batch_id" optional="show" />
                <field name="over_limit" optional="hide" />
                <field name="limit_note" optional="hide" />
                <field name="paid_date" />
                <field name="settled_amount" sum="Total" />
                <field name="balance" sum="Total" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'approved'"
                    decoration-success="state == 'paid'"
                />
                <field name="currency_id" column_invisible="True" />
                <field name="company_id" groups="base.group_multi_company" optional="hide" />
            </list>
        </field>
    </record>

    <record id="l10n_vn_payroll_advance_view_form" model="ir.ui.view">
        <field name="name">l10n_vn.payroll.advance.form</field>
        <field name="model">l10n_vn.payroll.advance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_approve"
                        type="object"
                        string="Approve"
                        class="oe_highlight"
                        invisible="state != 'draft'"
                        groups="l10n_vn_payroll.group_payroll_reviewer"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state not in ('draft', 'approved')"
                        groups="payroll.group_payroll_user"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state != 'paid'"
                        groups="l10n_vn_payroll.group_payroll_reviewer"
                        confirm="Cancel this paid advance?"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,paid" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'" />
                            <field name="date" readonly="state != 'draft'" />
                            <field name="amount" readonly="state != 'draft'" />
                            <field name="reason" readonly="state != 'draft'" />
                            <field name="batch_id" readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field name="eligible" />
                            <field name="days_worked" />
                            <field name="earned_amount" />
                            <field name="monthly_amount" />
                            <field name="limit_left" />
                            <field name="over_limit" />
                            <field name="limit_note" readonly="state != 'draft'" />
                            <field name="approved_by" />
                            <field name="approved_at" />
                            <field name="limit_at_approval" />
                            <field name="paid_date" />
                            <field name="payment_id" />
                            <field name="settled_amount" />
                            <field name="balance" />
                            <field name="currency_id" invisible="1" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Settlements" name="settlements">
                            <field name="settlement_ids">
                                <list>
                                    <field name="payslip_id" />
                                    <field name="payslip_state" />
                                    <field name="amount" />
                                    <field name="currency_id" column_invisible="True" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_vn_payroll_advance_view_search" model="ir.ui.view">
        <field name="name">l10n_vn.payroll.advance.search</field>
        <field name="model">l10n_vn.payroll.advance</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id" />
                <field name="batch_id" />
                <field name="reason" />
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]" />
                <filter name="to_pay" string="To Pay" domain="[('state', '=', 'approved')]" />
                <filter
                    name="open_balance"
                    string="Open Balance"
                    domain="[('state', '=', 'paid'), ('balance', '>', 0)]"
                />
                <separator />
                <filter name="filter_date" string="Date" date="date" />
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}" />
                    <filter name="group_batch" string="Batch" context="{'group_by': 'batch_id'}" />
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}" />
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_vn_payroll_advance_action" model="ir.actions.act_window">
        <field name="name">Salary Advances</field>
        <field name="res_model">l10n_vn.payroll.advance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
