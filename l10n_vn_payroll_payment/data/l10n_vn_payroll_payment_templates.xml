<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="xlsx_bank_transfer" model="xlsx.template">
            <field name="name">Bank Transfer</field>
            <field name="res_model">l10n_vn.payroll.payment</field>
            <field name="fname">bank_transfer.xlsx</field>
            <field name="datas" type="base64" file="l10n_vn_payroll_payment/templates/bank_transfer.xlsx" />
        </record>
        <record id="xlsx_bank_transfer_line_1" model="xlsx.template.export">
            <field name="template_id" ref="xlsx_bank_transfer" />
            <field name="sequence">10</field>
            <field name="section_type">sheet</field>
            <field name="sheet">1</field>
        </record>
        <record id="xlsx_bank_transfer_line_2" model="xlsx.template.export">
            <field name="template_id" ref="xlsx_bank_transfer" />
            <field name="sequence">20</field>
            <field name="section_type">row</field>
            <field name="row_field">transfer_line_ids</field>
        </record>
        <record id="xlsx_bank_transfer_line_3" model="xlsx.template.export">
            <field name="template_id" ref="xlsx_bank_transfer" />
            <field name="sequence">30</field>
            <field name="section_type">data</field>
            <field name="excel_cell">A2</field>
            <field name="field_name">number</field>
        </record>
        <record id="xlsx_bank_transfer_line_4" model="xlsx.template.export">
            <field name="template_id" ref="xlsx_bank_transfer" />
            <field name="sequence">40</field>
            <field name="section_type">data</field>
            <field name="excel_cell">B2</field>
            <field name="field_name">employee_id.name</field>
        </record>
        <record id="xlsx_bank_transfer_line_5" model="xlsx.template.export">
            <field name="template_id" ref="xlsx_bank_transfer" />
            <field name="sequence">50</field>
            <field name="section_type">data</field>
            <field name="excel_cell">C2</field>
            <field name="field_name">employee_id.department_id.name</field>
        </record>
        <record id="xlsx_bank_transfer_line_6" model="xlsx.template.export">
            <field name="template_id" ref="xlsx_bank_transfer" />
            <field name="sequence">60</field>
            <field name="section_type">data</field>
            <field name="excel_cell">D2</field>
            <field name="field_name">employee_id.job_id.name</field>
        </record>
        <record id="xlsx_bank_transfer_line_7" model="xlsx.template.export">
            <field name="template_id" ref="xlsx_bank_transfer" />
            <field name="sequence">70</field>
            <field name="section_type">data</field>
            <field name="excel_cell">E2</field>
            <field name="field_name">payment_id.company_bank_id.acc_number</field>
        </record>
        <record id="xlsx_bank_transfer_line_8" model="xlsx.template.export">
            <field name="template_id" ref="xlsx_bank_transfer" />
            <field name="sequence">80</field>
            <field name="section_type">data</field>
            <field name="excel_cell">F2</field>
            <field name="field_name">bank_account_id.acc_number</field>
        </record>
        <record id="xlsx_bank_transfer_line_9" model="xlsx.template.export">
            <field name="template_id" ref="xlsx_bank_transfer" />
            <field name="sequence">90</field>
            <field name="section_type">data</field>
            <field name="excel_cell">G2</field>
            <field name="field_name">bank_account_id.acc_holder_name</field>
            <field name="field_cond">${value or object.employee_id.name}</field>
        </record>
        <record id="xlsx_bank_transfer_line_10" model="xlsx.template.export">
            <field name="template_id" ref="xlsx_bank_transfer" />
            <field name="sequence">100</field>
            <field name="section_type">data</field>
            <field name="excel_cell">H2</field>
            <field name="field_name">amount</field>
        </record>
        <record id="xlsx_bank_transfer_line_11" model="xlsx.template.export">
            <field name="template_id" ref="xlsx_bank_transfer" />
            <field name="sequence">110</field>
            <field name="section_type">data</field>
            <field name="excel_cell">I2</field>
            <field name="field_name">bank_account_id.bank_id.name</field>
        </record>
        <record id="xlsx_bank_transfer_line_12" model="xlsx.template.export">
            <field name="template_id" ref="xlsx_bank_transfer" />
            <field name="sequence">120</field>
            <field name="section_type">data</field>
            <field name="excel_cell">J2</field>
            <field name="field_name">bank_account_id.bank_id.bic</field>
        </record>
        <record id="xlsx_bank_transfer_line_13" model="xlsx.template.export">
            <field name="template_id" ref="xlsx_bank_transfer" />
            <field name="sequence">130</field>
            <field name="section_type">data</field>
            <field name="excel_cell">L2</field>
            <field name="field_name">id</field>
            <field name="field_cond">${"OUR"}</field>
        </record>
        <record id="xlsx_bank_transfer_line_14" model="xlsx.template.export">
            <field name="template_id" ref="xlsx_bank_transfer" />
            <field name="sequence">140</field>
            <field name="section_type">data</field>
            <field name="excel_cell">M2</field>
            <field name="field_name">payment_id.date</field>
        </record>
    </data>
</odoo>
