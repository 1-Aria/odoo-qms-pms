<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sale_order_vn">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="l10n_vn_sale_report.report_sale_order_vn_document" t-lang="'vi_VN'">
                    <t t-set="compact" t-value="False"/>
                </t>
            </t>
        </t>
    </template>

    <template id="report_sale_order_vn_compact">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="l10n_vn_sale_report.report_sale_order_vn_document" t-lang="'vi_VN'">
                    <t t-set="compact" t-value="True"/>
                </t>
            </t>
        </t>
    </template>

    <template id="report_sale_order_vn_document">
        <t t-set="o" t-value="o.with_context(lang='vi_VN')"/>
        <t t-set="v" t-value="o._l10n_vn_order_data(compact)"/>
        <t t-call="l10n_vn_voucher.voucher_article">
            <t t-call="l10n_vn_voucher.voucher_page">
                <t t-call="l10n_vn_voucher.voucher_header">
                    <t t-set="company" t-value="v['company']"/>
                    <t t-set="department" t-value="None"/>
                    <t t-set="form_code" t-value="False"/>
                </t>
                <t t-call="l10n_vn_voucher.voucher_title">
                    <t t-set="title" t-value="v['title']"/>
                    <t t-set="voucher_date" t-value="v['date']"/>
                    <t t-set="number" t-value="v['number']"/>
                    <t t-set="show_accounts" t-value="False"/>
                </t>
                <t t-call="l10n_vn_voucher.voucher_party">
                    <t t-set="party_title" t-value="'Bên bán'"/>
                    <t t-set="partner" t-value="v['seller']"/>
                </t>
                <t t-call="l10n_vn_voucher.voucher_party">
                    <t t-set="party_title" t-value="'Bên mua'"/>
                    <t t-set="partner" t-value="v['buyer']"/>
                </t>
                <t t-call="l10n_vn_voucher.voucher_field">
                    <t t-set="label" t-value="'Số tham chiếu của khách hàng'"/>
                    <t t-set="value" t-value="v['customer_ref']"/>
                </t>
                <t t-if="v['validity_date'] is not False" t-call="l10n_vn_voucher.voucher_field">
                    <t t-set="label" t-value="'Báo giá có hiệu lực đến'"/>
                    <t t-set="value" t-value="v['validity_date']"/>
                </t>
                <t t-call="l10n_vn_voucher.voucher_field">
                    <t t-set="label" t-value="'Ngày giao hàng'"/>
                    <t t-set="value" t-value="v['delivery_date']"/>
                </t>
                <t t-call="l10n_vn_voucher.voucher_field">
                    <t t-set="label" t-value="'Địa chỉ giao hàng'"/>
                    <t t-set="value" t-value="v['delivery_address']"/>
                </t>
                <t t-call="l10n_vn_voucher.voucher_field">
                    <t t-set="label" t-value="'Điều khoản thanh toán'"/>
                    <t t-set="value" t-value="v['payment_term']"/>
                </t>
                <t t-call="l10n_vn_voucher.voucher_order_lines">
                    <t t-set="rows" t-value="v['rows']"/>
                    <t t-set="currency" t-value="v['currency']"/>
                    <t t-set="show_discount" t-value="v['show_discount']"/>
                </t>
                <t t-call="l10n_vn_voucher.voucher_variant_grids">
                    <t t-set="grids" t-value="v['grids']"/>
                </t>
                <t t-call="l10n_vn_voucher.voucher_totals">
                    <t t-set="currency" t-value="v['currency']"/>
                    <t t-set="untaxed" t-value="v['untaxed']"/>
                    <t t-set="tax" t-value="v['tax']"/>
                    <t t-set="total" t-value="v['total']"/>
                </t>
                <div t-if="v['notes']" class="l10n_vn_voucher_notes">
                    <strong>Ghi chú:</strong>
                    <div t-out="v['notes']"/>
                </div>
                <t t-call="l10n_vn_voucher.voucher_signatures">
                    <t t-set="sign_date" t-value="None"/>
                    <t t-set="signers" t-value="v['signers']"/>
                </t>
            </t>
        </t>
    </template>
</odoo>
