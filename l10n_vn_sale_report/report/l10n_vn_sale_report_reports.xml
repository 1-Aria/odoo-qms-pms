<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_sale_order_vn" model="ir.actions.report">
        <field name="name">Đơn bán hàng (VN)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_vn_sale_report.report_sale_order_vn</field>
