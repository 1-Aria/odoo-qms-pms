<odoo>

    <record id="maintenance_request_sla_waive_view_form" model="ir.ui.view">
        <field name="name">maintenance.request.sla.waive.form</field>
        <field name="model">maintenance.request.sla.waive</field>
        <field name="arch" type="xml">
            <form string="Waive SLA Record">
                <group>
                    <!-- force_save: a readonly field is not sent on save, and
                         the record comes from the context default. -->
                    <field name="sla_record_id" force_save="1" />
                    <field name="reason_id" options="{'no_create': True}" />
                    <field name="note" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Waive"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="maintenance_request_sla_waive_action" model="ir.actions.act_window">
        <field name="name">Waive SLA Record</field>
        <field name="res_model">maintenance.request.sla.waive</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
