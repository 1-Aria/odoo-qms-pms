<odoo>

    <record id="hr_equipment_stage_view_tree" model="ir.ui.view">
        <field name="name">equipment.stage.list.sla</field>
        <field name="model">maintenance.stage</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_stage_view_tree" />
        <field name="arch" type="xml">
            <!-- Core ships no form for a stage, only this editable list
                 (maintenance/views/maintenance_views.xml:706-716), so the flag
                 sits beside fold and done. Not optional: a flag that cancels
                 commitments should not be hideable. -->
            <field name="done" position="after">
                <field name="sla_cancel" />
            </field>
        </field>
    </record>

</odoo>
