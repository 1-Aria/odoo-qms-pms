<odoo>

    <record id="qc_test_form_view" model="ir.ui.view">
        <field name="name">qc.test.form.qms.roll.inspection</field>
        <field name="model">qc.test</field>
        <field name="inherit_id" ref="quality_control_oca.qc_test_form_view" />
        <field name="arch" type="xml">
            <!-- The base form's only inner group (category, pre-fill,
                 company); this becomes its second column. -->
            <xpath expr="//sheet/group/group" position="after">
                <group string="Roll Inspection" name="qms_roll_inspection_settings">
                    <field name="qms_roll_inspection" />
                    <field
                        name="qms_points_limit"
                        invisible="not qms_roll_inspection"
                    />
                    <field
                        name="qms_points_cap"
                        invisible="not qms_roll_inspection"
                    />
                    <field
                        name="qms_delta_e_max"
                        invisible="not qms_roll_inspection"
                    />
                    <field
                        name="qms_delta_e_length_max"
                        invisible="not qms_roll_inspection"
                    />
                    <field
                        name="qms_delta_e_width_max"
                        invisible="not qms_roll_inspection"
                    />
                </group>
            </xpath>
        </field>
    </record>

</odoo>
