<odoo>

    <!-- Inherits the stock bridge's extension rather than the base form, so
         its lot_id and the base form's notebook are both in reach. -->
    <record id="qc_inspection_form_view" model="ir.ui.view">
        <field name="name">qc.inspection.form.qms.rolls</field>
        <field name="model">qc.inspection</field>
        <field
            name="inherit_id"
            ref="quality_control_stock_oca.qc_inspection_form_view_picking"
        />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="qms_roll_inspection" invisible="1" />
            </field>
            <!-- On a receipt-line inspection OCA's compute names the move's
                 first lot (quality_control_stock_oca/models/qc_inspection.py:
                 42-57), one roll among many; the Rolls page is the truth. -->
            <field name="lot_id" position="attributes">
                <attribute name="invisible">qms_roll_inspection</attribute>
            </field>
            <!-- The Questions page carries only a translated string, which
                 view inheritance may not select on, so it is taken by
                 position. -->
            <xpath expr="//notebook/page[1]" position="after">
                <page
                    string="Rolls"
                    name="qms_rolls"
                    invisible="not qms_roll_inspection"
                >
                    <group>
                        <group>
                            <field name="qms_points_limit" />
                            <field name="qms_points_cap" />
                            <field name="qms_delta_e_max" />
                            <field name="qms_delta_e_length_max" />
                            <field name="qms_delta_e_width_max" />
                        </group>
                        <group>
                            <field name="qms_show_all_codes" />
                        </group>
                    </group>
                    <!-- Editable in ready only, as OCA's Questions page. Editable
                         in place so shade can be typed for every roll; the point
                         entries open from the row's button, core's pattern for
                         picking moves (stock.move.action_show_details). -->
                    <field
                        name="qms_roll_ids"
                        nolabel="1"
                        readonly="state != 'ready'"
                    >
                        <list editable="bottom" decoration-danger="not passed">
                            <field
                                name="lot_id"
                                domain="[('product_id', '=', parent.product_id)]"
                                options="{'no_create': True}"
                            />
                            <field name="dye_lot" optional="show" />
                            <field name="length" />
                            <field name="width" />
                            <field name="total_points" />
                            <field name="score" digits="[16,1]" />
                            <button
                                name="action_qms_open_points"
                                type="object"
                                icon="fa-list"
                                title="Points"
                            />
                            <field
                                name="delta_e"
                                digits="[16,2]"
                                optional="show"
                            />
                            <field
                                name="delta_e_length"
                                digits="[16,2]"
                                optional="show"
                            />
                            <field
                                name="delta_e_width"
                                digits="[16,2]"
                                optional="show"
                            />
                            <field name="shade_band" />
                            <field name="passed" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
