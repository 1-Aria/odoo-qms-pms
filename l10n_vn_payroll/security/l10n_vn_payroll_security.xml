<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Roles -->
    <record id="group_payroll_reviewer" model="res.groups">
        <field name="name">Reviewer</field>
        <field name="category_id" ref="payroll.module_category_payroll" />
        <field name="implied_ids" eval="[Command.link(ref('payroll.group_payroll_user'))]" />
    </record>
    <record id="group_payroll_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="category_id" ref="payroll.module_category_payroll" />
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>
    <record id="group_payroll_reader" model="res.groups">
        <field name="name">Reader</field>
        <field name="category_id" ref="payroll.module_category_payroll" />
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <!-- Payroll managers manage time parameters -->
    <record id="payroll.group_payroll_manager" model="res.groups">
        <field
            name="implied_ids"
            eval="[Command.link(ref('base_time_parameter.group_time_parameter'))]"
        />
    </record>

    <!-- New users receive no payroll role -->
    <data noupdate="1">
        <record id="base.default_user" model="res.users">
            <field
                name="groups_id"
                eval="[Command.unlink(ref('payroll.group_payroll_manager')), Command.unlink(ref('payroll.group_payroll_user'))]"
            />
        </record>
    </data>

    <!-- Officers see every payslip of their companies -->
    <record id="rule_payslip_officer_all" model="ir.rule">
        <field name="name">Payslip: officers see all</field>
        <field name="model_id" ref="payroll.model_hr_payslip" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('payroll.group_payroll_user'))]" />
    </record>

    <!-- Company rules -->
    <record id="rule_component_company" model="ir.rule">
        <field name="name">Payroll component: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_payroll_component" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_scale_company" model="ir.rule">
        <field name="name">Payroll scale: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_payroll_scale" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_scale_version_company" model="ir.rule">
        <field name="name">Payroll scale version: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_payroll_scale_version" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_scale_cell_company" model="ir.rule">
        <field name="name">Payroll scale cell: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_payroll_scale_cell" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_contract_line_company" model="ir.rule">
        <field name="name">Contract pay line: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_payroll_contract_line" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_period_company" model="ir.rule">
        <field name="name">Payroll period: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_payroll_period" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_input_company" model="ir.rule">
        <field name="name">Monthly payroll input: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_payroll_input" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_input_segment_company" model="ir.rule">
        <field name="name">Monthly payroll input segment: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_payroll_input_segment" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_input_line_company" model="ir.rule">
        <field name="name">Monthly payroll input line: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_payroll_input_line" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
