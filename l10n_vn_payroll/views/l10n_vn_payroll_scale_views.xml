<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_vn_payroll_scale_view_list" model="ir.ui.view">
        <field name="name">l10n_vn.payroll.scale.list</field>
        <field name="model">l10n_vn.payroll.scale</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" />
                <field name="name" />
                <field name="kind" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="l10n_vn_payroll_scale_view_form" model="ir.ui.view">
        <field name="name">l10n_vn.payroll.scale.form</field>
        <field name="model">l10n_vn.payroll.scale</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="kind" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                    </group>
                    <field name="version_ids">
                        <list>
                            <field name="date_from" />
                            <field name="note" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_vn_payroll_scale_version_view_form" model="ir.ui.view">
        <field name="name">l10n_vn.payroll.scale.version.form</field>
        <field name="model">l10n_vn.payroll.scale.version</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="scale_id" readonly="1" />
                            <field name="date_from" />
                            <field name="note" />
                        </group>
                    </group>
                    <field name="cell_ids">
                        <list editable="bottom">
                            <field name="key" />
                            <field name="grade" />
                            <field name="step" />
                            <field name="amount" />
                            <field name="currency_id" column_invisible="True" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_vn_payroll_scale_action" model="ir.actions.act_window">
        <field name="name">Pay Scales</field>
        <field name="res_model">l10n_vn.payroll.scale</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
