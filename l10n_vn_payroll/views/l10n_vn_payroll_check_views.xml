<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_vn_payroll_check_view_list" model="ir.ui.view">
        <field name="name">l10n_vn.payroll.check.list</field>
        <field name="model">l10n_vn.payroll.check</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="code" />
                <field name="name" />
                <field name="kind" />
                <field name="default_level" />
                <field name="per_component" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="l10n_vn_payroll_check_view_form" model="ir.ui.view">
        <field name="name">l10n_vn.payroll.check.form</field>
        <field name="model">l10n_vn.payroll.check</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="name" />
                            <field name="kind" />
                        </group>
                        <group>
                            <field name="default_level" />
                            <field name="per_component" />
                            <field name="active" />
                        </group>
                    </group>
                    <p class="text-muted">
                        The level comes from the time parameter vn.check.&lt;code&gt;, or
                        vn.check.&lt;code&gt;.&lt;component code&gt; for a component, with the
                        value error, warning, note or off. Integrity checks are always errors.
                    </p>
                    <field name="description" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_vn_payroll_check_action" model="ir.actions.act_window">
        <field name="name">Payroll Checks</field>
        <field name="res_model">l10n_vn.payroll.check</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="l10n_vn_payroll_check_result_view_list" model="ir.ui.view">
        <field name="name">l10n_vn.payroll.check.result.list</field>
        <field name="model">l10n_vn.payroll.check.result</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="payslip_id" readonly="1" />
                <field name="employee_id" readonly="1" />
                <field name="check_id" readonly="1" />
                <field name="component_id" readonly="1" optional="show" />
                <field
                    name="level"
                    readonly="1"
                    decoration-danger="level == 'error'"
                    decoration-warning="level == 'warning'"
                    widget="badge"
                />
                <field name="message" readonly="1" />
                <field name="note" groups="l10n_vn_payroll.group_payroll_reviewer" />
                <field
                    name="note"
                    readonly="1"
                    groups="!l10n_vn_payroll.group_payroll_reviewer"
                />
                <field name="noted_by" optional="show" />
            </list>
        </field>
    </record>

    <record id="l10n_vn_payroll_check_result_view_search" model="ir.ui.view">
        <field name="name">l10n_vn.payroll.check.result.search</field>
        <field name="model">l10n_vn.payroll.check.result</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id" />
                <field name="check_id" />
                <filter name="errors" string="Errors" domain="[('level', '=', 'error')]" />
                <filter name="warnings" string="Warnings" domain="[('level', '=', 'warning')]" />
                <filter name="without_note" string="Without note" domain="[('note', '=', False)]" />
                <group expand="0" string="Group By">
                    <filter name="group_check" string="Check" context="{'group_by': 'check_id'}" />
                    <filter name="group_level" string="Level" context="{'group_by': 'level'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_vn_payroll_check_result_action" model="ir.actions.act_window">
        <field name="name">Check Results</field>
        <field name="res_model">l10n_vn.payroll.check.result</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_errors': 1, 'search_default_warnings': 1}</field>
    </record>

    <record id="hr_payslip_view_form_l10n_vn_checks" model="ir.ui.view">
        <field name="name">hr.payslip.form.l10n_vn_checks</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='computation']" position="after">
                <page string="Checks" name="l10n_vn_checks" invisible="not l10n_vn_check_result_ids">
                    <field name="l10n_vn_check_result_ids" readonly="0">
                        <list editable="bottom" create="0" delete="0">
                            <field
                                name="level"
                                readonly="1"
                                decoration-danger="level == 'error'"
                                decoration-warning="level == 'warning'"
                                widget="badge"
                            />
                            <field name="check_id" readonly="1" />
                            <field name="component_id" readonly="1" optional="show" />
                            <field name="message" readonly="1" />
                            <field name="note" groups="l10n_vn_payroll.group_payroll_reviewer" />
                            <field
                                name="note"
                                readonly="1"
                                groups="!l10n_vn_payroll.group_payroll_reviewer"
                            />
                            <field name="noted_by" optional="show" />
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//page[@name='computation']/group" position="after">
                <group string="Summary" name="l10n_vn_summary" invisible="not l10n_vn_context">
                    <group>
                        <field name="l10n_vn_paid_days" />
                        <field name="l10n_vn_days_worked" />
                        <field name="l10n_vn_ot_wd_hours" />
                        <field name="l10n_vn_ot_rd_hours" />
                        <field name="l10n_vn_ot_hol_hours" />
                        <field name="l10n_vn_si_base" />
                        <field name="l10n_vn_taxable" />
                    </group>
                    <group>
                        <field name="l10n_vn_currency_id" invisible="1" />
                        <field name="l10n_vn_gross" />
                        <field name="l10n_vn_employee_insurance" />
                        <field name="l10n_vn_pit" />
                        <field name="l10n_vn_net" />
                        <field name="l10n_vn_advance" />
                        <field name="l10n_vn_to_pay" />
                        <field name="l10n_vn_employer_cost" />
                    </group>
                </group>
            </xpath>
            <xpath expr="//group[@name='top']//field[@name='contract_id']" position="after">
                <field
                    name="l10n_vn_check_level"
                    invisible="not l10n_vn_check_level"
                    decoration-danger="l10n_vn_check_level == 'error'"
                    decoration-warning="l10n_vn_check_level == 'warning'"
                    widget="badge"
                />
            </xpath>
        </field>
    </record>

    <record id="hr_payslip_view_tree_l10n_vn_checks" model="ir.ui.view">
        <field name="name">hr.payslip.list.l10n_vn_checks</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_tree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field
                    name="l10n_vn_check_level"
                    optional="show"
                    decoration-danger="l10n_vn_check_level == 'error'"
                    decoration-warning="l10n_vn_check_level == 'warning'"
                    widget="badge"
                />
            </field>
        </field>
    </record>

    <record id="hr_contract_view_form_l10n_vn_probation_job" model="ir.ui.view">
        <field name="name">hr.contract.form.l10n_vn_probation_job</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract_view_form_l10n_vn_payroll" />
        <field name="arch" type="xml">
            <field name="l10n_vn_probation_form" position="after">
                <field
                    name="l10n_vn_probation_job"
                    invisible="l10n_vn_probation_form == 'none'"
                />
            </field>
        </field>
    </record>
</odoo>
