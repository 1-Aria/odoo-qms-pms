<odoo>
    <record id="hr_contract_type_view_form" model="ir.ui.view">
        <field name="name">hr.contract.type.form.inherit.l10n_vn_payroll</field>
        <field name="model">hr.contract.type</field>
        <field name="inherit_id" ref="hr.hr_contract_type_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_vn_participant_type_id" groups="payroll.group_payroll_user" />
            </xpath>
        </field>
    </record>
    <record id="hr_contract_type_view_tree" model="ir.ui.view">
        <field name="name">hr.contract.type.list.inherit.l10n_vn_payroll</field>
        <field name="model">hr.contract.type</field>
        <field name="inherit_id" ref="hr.hr_contract_type_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_vn_participant_type_id" groups="payroll.group_payroll_user" />
            </xpath>
        </field>
    </record>
</odoo>
