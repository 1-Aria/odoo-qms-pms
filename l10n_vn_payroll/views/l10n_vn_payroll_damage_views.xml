<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_vn_payroll_damage_view_list" model="ir.ui.view">
        <field name="name">l10n_vn.payroll.damage.list</field>
        <field name="model">l10n_vn.payroll.damage</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id" />
                <field name="decision_ref" />
                <field name="decision_date" />
                <field name="reason" />
                <field name="amount" />
                <field name="deducted" />
                <field name="balance" />
                <field name="state" />
                <field name="currency_id" column_invisible="True" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="l10n_vn_payroll_damage_view_form" model="ir.ui.view">
        <field name="name">l10n_vn.payroll.damage.form</field>
        <field name="model">l10n_vn.payroll.damage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" />
                            <field name="decision_ref" />
                            <field name="decision_date" />
                            <field name="reason" />
                            <field name="amount" />
                        </group>
                        <group>
                            <field name="deducted" />
                            <field name="balance" />
                            <field name="state" />
                            <field name="currency_id" invisible="1" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Deductions" name="deductions">
                            <field name="allocation_ids" readonly="1">
                                <list>
                                    <field name="payslip_id" />
                                    <field name="payslip_state" />
                                    <field name="amount" />
                                    <field name="currency_id" column_invisible="True" />
                                </list>
                            </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_vn_payroll_damage_view_search" model="ir.ui.view">
        <field name="name">l10n_vn.payroll.damage.search</field>
        <field name="model">l10n_vn.payroll.damage</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id" />
                <field name="decision_ref" />
                <filter name="open" string="Open" domain="[('state', '=', 'open')]" />
                <group expand="0" string="Group By">
                    <filter
                        name="group_employee"
                        string="Employee"
                        context="{'group_by': 'employee_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_vn_payroll_damage_action" model="ir.actions.act_window">
        <field name="name">Damage Decisions</field>
        <field name="res_model">l10n_vn.payroll.damage</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
