<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_payslip_view_form_l10n_vn_payroll" model="ir.ui.view">
        <field name="name">hr.payslip.form.l10n_vn_payroll</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='top']//field[@name='contract_id']" position="after">
                <field name="l10n_vn_input_id" invisible="not l10n_vn_input_id" />
            </xpath>
            <xpath
                expr="//field[@name='dynamic_filtered_payslip_lines']/list/field[@name='quantity']"
                position="before"
            >
                <field name="l10n_vn_date_from" optional="hide" />
                <field name="l10n_vn_date_to" optional="hide" />
                <field name="l10n_vn_days" optional="hide" />
                <field name="l10n_vn_hours" optional="hide" />
                <field name="l10n_vn_factor" optional="hide" />
                <field name="l10n_vn_unit_amount" optional="hide" />
                <field name="l10n_vn_attainment" optional="hide" />
                <field name="l10n_vn_period_ref" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
