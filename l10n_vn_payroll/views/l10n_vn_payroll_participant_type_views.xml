<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_vn_payroll_participant_type_view_list" model="ir.ui.view">
        <field name="name">l10n_vn.payroll.participant.type.list</field>
        <field name="model">l10n_vn.payroll.participant.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" />
                <field name="name" />
                <field name="fund_pension" />
                <field name="fund_sickness" />
                <field name="fund_accident" />
                <field name="fund_hi" />
                <field name="fund_ui" />
                <field name="fund_union_fee" />
                <field name="dues_allowed" />
                <field name="base_source" />
                <field name="floor" />
                <field name="pit_method" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="l10n_vn_payroll_participant_type_view_form" model="ir.ui.view">
        <field name="name">l10n_vn.payroll.participant.type.form</field>
        <field name="model">l10n_vn.payroll.participant.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <group>
                        <group string="Funds" name="funds">
                            <field name="fund_pension" />
                            <field name="fund_sickness" />
                            <field name="fund_accident" />
                            <field name="fund_hi" />
                            <field name="fund_ui" />
                            <field name="fund_union_fee" />
                            <field name="dues_allowed" />
                        </group>
                        <group string="Base and tax" name="base">
                            <field name="base_source" />
                            <field name="floor" />
                            <field name="pit_method" />
                        </group>
                    </group>
                    <field name="note" placeholder="Notes" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_vn_payroll_participant_type_action" model="ir.actions.act_window">
        <field name="name">Participant Types</field>
        <field name="res_model">l10n_vn.payroll.participant.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
