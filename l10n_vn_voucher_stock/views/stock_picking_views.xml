<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.l10n_vn_voucher_stock</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_infos']" position="inside">
                <field name="l10n_vn_voucher_kind" invisible="1"/>
                <field name="l10n_vn_voucher_reason"
                       invisible="not l10n_vn_voucher_kind"
                       readonly="state == 'cancel'"/>
            </xpath>
        </field>
    </record>
</odoo>
