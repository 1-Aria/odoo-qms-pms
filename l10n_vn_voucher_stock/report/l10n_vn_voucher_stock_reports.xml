<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_stock_voucher_in" model="ir.actions.report">
        <field name="name">Phiếu nhập kho</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_vn_voucher_stock.report_stock_voucher</field>
        <field name="report_file">l10n_vn_voucher_stock.report_stock_voucher</field>
        <field name="paperformat_id" ref="l10n_vn_voucher.paperformat_l10n_vn_voucher"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="domain">[("picking_type_id.l10n_vn_voucher_kind", "=", "in"), ("state", "!=", "cancel")]</field>
        <field name="print_report_name">'Phiếu nhập kho - %s' % (object.name)</field>
    </record>

    <record id="action_report_stock_voucher_out" model="ir.actions.report">
        <field name="name">Phiếu xuất kho</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_vn_voucher_stock.report_stock_voucher</field>
        <field name="report_file">l10n_vn_voucher_stock.report_stock_voucher</field>
        <field name="paperformat_id" ref="l10n_vn_voucher.paperformat_l10n_vn_voucher"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="domain">[("picking_type_id.l10n_vn_voucher_kind", "=", "out"), ("state", "!=", "cancel")]</field>
        <field name="print_report_name">'Phiếu xuất kho - %s' % (object.name)</field>
    </record>
</odoo>
