<odoo noupdate="1">

    <!-- For maintenance_equipment_status_automation. The stage mapping is set
         by the install hook, and by the 18.0.1.1.0 migration on a site that
         already had the preset; a stage already mapped keeps its status. No
         category limits: every machine can take each status. -->
    <record id="status_down" model="maintenance.equipment.status">
        <field name="name">Down</field>
        <field name="sequence">10</field>
    </record>

    <record id="status_operational" model="maintenance.equipment.status">
        <field name="name">Operational</field>
        <field name="sequence">20</field>
    </record>

    <record id="status_retired" model="maintenance.equipment.status">
        <field name="name">Retired</field>
        <field name="sequence">30</field>
    </record>

</odoo>
