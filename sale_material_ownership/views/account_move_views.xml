<odoo>
    <record id="view_move_form_material" model="ir.ui.view">
        <field name="name">account.move.form.material</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field
                    name="material_batch_id"
                    invisible="move_type not in ('in_invoice', 'in_refund') or not material_batch_id"
                />
            </xpath>
        </field>
    </record>
</odoo>
