<odoo>
    <record id="sale_material_batch_view_list" model="ir.ui.view">
        <field name="name">sale.material.batch.list</field>
        <field name="model">sale.material.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="date_request" />
                <field name="order_ids" widget="many2many_tags" optional="show" />
                <field name="amount_total" sum="Total" />
                <field name="currency_id" column_invisible="1" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'requested'"
                    decoration-success="state == 'covered'"
                    decoration-muted="state == 'cancel'"
                />
            </list>
        </field>
    </record>

    <record id="sale_material_batch_view_form" model="ir.ui.view">
        <field name="name">sale.material.batch.form</field>
        <field name="model">sale.material.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_add_uncovered"
                        string="Add Uncovered Orders"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_refresh"
                        string="Refresh"
                        type="object"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_request"
                        string="Request"
                        type="object"
                        class="btn-primary"
                        groups="account.group_account_invoice"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state not in ('draft', 'requested')"
                        confirm="Cancel this batch? Its draft bill is cancelled and its orders become free."
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,requested,covered"
                    />
                </header>
                <div class="alert alert-warning mb-0" role="alert" invisible="not warning">
                    <field name="warning" nolabel="1" />
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_bills"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            invisible="not bill_count"
                        >
                            <field name="bill_count" widget="statinfo" string="Bills" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                readonly="state != 'draft'"
                            />
                            <field name="currency_id" invisible="1" />
                        </group>
                        <group>
                            <field name="date_request" invisible="not date_request" />
                            <field name="requested_by_id" invisible="not date_request" />
                            <field name="amount_total" invisible="state == 'draft'" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Sales Orders" name="orders">
                            <field
                                name="order_ids"
                                readonly="state != 'draft'"
                                options="{'no_create': True}"
                            >
                                <list>
                                    <field name="name" />
                                    <field name="partner_id" />
                                    <field name="date_order" />
                                    <field name="amount_untaxed" sum="Total" />
                                    <field name="currency_id" column_invisible="1" />
                                    <field name="material_coverage" widget="badge" />
                                </list>
                            </field>
                        </page>
                        <page string="Materials" name="needs">
                            <field name="need_line_ids">
                                <list decoration-warning="not exploded">
                                    <field name="order_id" />
                                    <field name="sold_product_id" />
                                    <field name="line_qty" />
                                    <field name="product_id" />
                                    <field name="material_qty" />
                                    <field name="uom_id" />
                                    <field name="bom_id" optional="hide" />
                                    <field name="exploded" optional="hide" />
                                </list>
                            </field>
                        </page>
                        <page string="Request" name="requests" invisible="state == 'draft'">
                            <field name="request_line_ids">
                                <list>
                                    <field name="product_id" />
                                    <field name="uom_id" />
                                    <field name="need_qty" />
                                    <field name="available_qty" />
                                    <field name="shortfall_qty" optional="hide" />
                                    <field name="request_qty" />
                                    <field name="unit_cost" />
                                    <field name="amount" sum="Total" />
                                    <field name="currency_id" column_invisible="1" />
                                    <field name="billed_qty" />
                                    <field
                                        name="difference_qty"
                                        decoration-danger="difference_qty &lt; 0"
                                    />
                                </list>
                            </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="sale_material_batch_view_search" model="ir.ui.view">
        <field name="name">sale.material.batch.search</field>
        <field name="model">sale.material.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="order_ids" />
                <filter
                    name="open"
                    string="Open"
                    domain="[('state', 'in', ['draft', 'requested'])]"
                />
                <separator />
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]" />
                <filter
                    name="requested"
                    string="Requested"
                    domain="[('state', '=', 'requested')]"
                />
                <filter name="covered" string="Covered" domain="[('state', '=', 'covered')]" />
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_sale_material_batch" model="ir.actions.act_window">
        <field name="name">Material Transfer Batches</field>
        <field name="res_model">sale.material.batch</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <menuitem
        id="menu_sale_material_batch"
        parent="sale.sale_order_menu"
        action="action_sale_material_batch"
        sequence="30"
    />
    <menuitem
        id="menu_account_material_batch"
        parent="account.menu_finance_payables"
        action="action_sale_material_batch"
        groups="account.group_account_invoice"
        sequence="30"
    />
</odoo>
