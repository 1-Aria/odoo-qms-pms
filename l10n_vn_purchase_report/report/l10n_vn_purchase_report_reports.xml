<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_purchase_order_vn" model="ir.actions.report">
        <field name="name">Đơn đặt hàng (VN)</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_vn_purchase_report.report_purchase_order_vn</field>
        <field name="report_file">l10n_vn_purchase_report.report_purchase_order_vn</field>
        <field name="paperformat_id" ref="l10n_vn_voucher.paperformat_l10n_vn_voucher"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
        <field name="domain">[("state", "!=", "cancel")]</field>
        <field name="print_report_name">'Đơn đặt hàng - %s' % (object.name)</field>
    </record>

    <record id="action_report_purchase_order_vn_compact" model="ir.actions.report">
        <field name="name">Đơn đặt hàng gọn (VN)</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_vn_purchase_report.report_purchase_order_vn_compact</field>
        <field name="report_file">l10n_vn_purchase_report.report_purchase_order_vn_compact</field>
        <field name="paperformat_id" ref="l10n_vn_voucher.paperformat_l10n_vn_voucher"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
        <field name="domain">[("state", "!=", "cancel")]</field>
        <field name="print_report_name">'Đơn đặt hàng gọn - %s' % (object.name)</field>
    </record>
    <record id="action_report_purchase_agreement_vn" model="ir.actions.report">
        <field name="name">Hợp đồng nguyên tắc / gia công (VN)</field>
        <field name="model">purchase.requisition</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_vn_purchase_report.report_purchase_agreement_vn</field>
        <field name="report_file">l10n_vn_purchase_report.report_purchase_agreement_vn</field>
        <field name="paperformat_id" ref="l10n_vn_voucher.paperformat_l10n_vn_voucher"/>
        <field name="binding_model_id" ref="purchase_requisition.model_purchase_requisition"/>
        <field name="binding_type">report</field>
        <field name="domain">[("requisition_type", "=", "blanket_order"), ("state", "!=", "cancel")]</field>
        <field name="print_report_name">'Hợp đồng - %s' % (object.name)</field>
    </record>
</odoo>
