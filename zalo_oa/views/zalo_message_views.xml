<odoo>

    <record id="zalo_message_view_list" model="ir.ui.view">
        <field name="name">zalo.message.list</field>
        <field name="model">zalo.message</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Queued" />
                <field name="display_name" string="Recipient" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'sent'"
                    decoration-danger="state == 'failed'"
                    decoration-info="state == 'queued'"
                />
                <field name="attempts" />
                <field name="sent_at" />
                <field name="last_error" optional="show" />
            </list>
        </field>
    </record>

    <!-- Editable while queued, so an administrator can queue a test message
         by hand; the record wakes the send cron like any other. -->
    <record id="zalo_message_view_form" model="ir.ui.view">
        <field name="name">zalo.message.form</field>
        <field name="model">zalo.message</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_retry"
                        string="Retry"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'failed'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field
                                name="destination_id"
                                readonly="state != 'queued'"
                            />
                            <field
                                name="recipient_type"
                                readonly="state != 'queued'"
                            />
                            <field
                                name="recipient_id"
                                readonly="state != 'queued'"
                            />
                        </group>
                        <group>
                            <field name="attempts" />
                            <field name="next_attempt_at" />
                            <field name="sent_at" />
                            <field name="sent_to" />
                            <field name="res_model" />
                            <field name="res_id" />
                        </group>
                    </group>
                    <field name="text" readonly="state != 'queued'" />
                    <group>
                        <field name="last_error" />
                        <field name="zalo_response" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="zalo_message_view_search" model="ir.ui.view">
        <field name="name">zalo.message.search</field>
        <field name="model">zalo.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="text" />
                <field name="recipient_id" />
                <field name="destination_id" />
                <filter
                    name="queued"
                    string="Queued"
                    domain="[('state', '=', 'queued')]"
                />
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]" />
                <filter
                    name="failed"
                    string="Failed"
                    domain="[('state', '=', 'failed')]"
                />
                <group name="group_by">
                    <filter
                        name="group_by_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_by_destination"
                        string="Destination"
                        context="{'group_by': 'destination_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="zalo_message_action" model="ir.actions.act_window">
        <field name="name">Zalo Messages</field>
        <field name="res_model">zalo.message</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_zalo_message"
        name="Messages"
        parent="menu_zalo_root"
        action="zalo_message_action"
        sequence="30"
    />

</odoo>
