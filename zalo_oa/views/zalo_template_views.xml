<odoo>

    <record id="zalo_template_view_list" model="ir.ui.view">
        <field name="name">zalo.template.list</field>
        <field name="model">zalo.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="model_id" />
            </list>
        </field>
    </record>

    <record id="zalo_template_view_form" model="ir.ui.view">
        <field name="name">zalo.template.form</field>
        <field name="model">zalo.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="model_id" options="{'no_create': True}" />
                    </group>
                    <field
                        name="body"
                        placeholder="New request {{ object.name }} on {{ object.equipment_id.name }}"
                    />
                </sheet>
            </form>
        </field>
    </record>

    <record id="zalo_template_view_search" model="ir.ui.view">
        <field name="name">zalo.template.search</field>
        <field name="model">zalo.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="model_id" />
                <group name="group_by">
                    <filter
                        name="group_by_model"
                        string="Model"
                        context="{'group_by': 'model_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="zalo_template_action" model="ir.actions.act_window">
        <field name="name">Zalo Templates</field>
        <field name="res_model">zalo.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_zalo_template"
        name="Templates"
        parent="menu_zalo_root"
        action="zalo_template_action"
        sequence="25"
    />

</odoo>
