<odoo>

    <record id="zalo_token_view_list" model="ir.ui.view">
        <field name="name">zalo.token.list</field>
        <field name="model">zalo.token</field>
        <field name="arch" type="xml">
            <list decoration-muted="not is_configured_app">
                <field name="app_id" />
                <field name="is_configured_app" />
                <field name="expires_at" />
                <field name="last_refresh_at" />
                <field name="alert_user_id" />
            </list>
        </field>
    </record>

    <!-- Tokens are typed by hand, masked. Refresh now only on this instance's
         app: refreshing another app's row is what the configuration exists to
         prevent. -->
    <record id="zalo_token_view_form" model="ir.ui.view">
        <field name="name">zalo.token.form</field>
        <field name="model">zalo.token</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_refresh_now"
                        string="Refresh now"
                        type="object"
                        class="btn-primary"
                        invisible="not is_configured_app"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="app_id" />
                            <field name="is_configured_app" />
                            <field name="access_token" widget="password" />
                            <field name="refresh_token" widget="password" />
                        </group>
                        <group>
                            <field name="expires_at" />
                            <field name="last_refresh_at" />
                            <field name="refresh_requested" />
                            <field name="alert_user_id" />
                        </group>
                    </group>
                    <group>
                        <field name="last_error" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="zalo_token_action" model="ir.actions.act_window">
        <field name="name">Zalo Tokens</field>
        <field name="res_model">zalo.token</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_zalo_root"
        name="Zalo"
        parent="base.menu_custom"
        sequence="90"
    />
    <menuitem
        id="menu_zalo_token"
        name="Tokens"
        parent="menu_zalo_root"
        action="zalo_token_action"
        sequence="10"
    />

</odoo>
