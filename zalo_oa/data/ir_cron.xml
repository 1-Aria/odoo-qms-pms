<!-- noupdate: an administrator's change to the cadence survives upgrades. -->
<odoo noupdate="1">

    <record id="ir_cron_zalo_token_refresh" model="ir.cron">
        <field name="name">Zalo: refresh token</field>
        <field name="model_id" ref="model_zalo_token" />
        <field name="state">code</field>
        <field name="code">model._cron_refresh()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True" />
        <field name="user_id" ref="base.user_root" />
    </record>

</odoo>
