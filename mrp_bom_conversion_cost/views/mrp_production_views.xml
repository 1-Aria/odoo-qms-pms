<odoo>
    <record id="mrp_production_form_view_conversion_cost" model="ir.ui.view">
        <field name="name">mrp.production.form.conversion.cost</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="conversion_cost_estimate"
                    groups="mrp.group_mrp_manager"
                    invisible="state in ('done', 'cancel') or not conversion_cost_estimate"/>
                <field name="extra_cost"
                    groups="mrp.group_mrp_manager"
                    readonly="1"
                    invisible="state != 'done'"/>
                <field name="conversion_rate_id"
                    groups="mrp.group_mrp_manager"
                    invisible="not conversion_rate_id"/>
                <field name="conversion_minutes"
                    groups="mrp.group_mrp_manager"
                    invisible="not conversion_rate_id"/>
            </xpath>
        </field>
    </record>
</odoo>
