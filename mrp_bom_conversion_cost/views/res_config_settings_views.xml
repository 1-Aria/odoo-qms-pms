<odoo>
    <record id="res_config_settings_view_form_conversion_cost" model="ir.ui.view">
        <field name="name">res.config.settings.form.conversion.cost</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mrp']" position="inside">
                <block title="Costing" name="conversion_cost_setting_container">
                    <setting id="conversion_cost_rate"
                        string="Conversion Cost per Minute"
                        company_dependent="1"
                        help="Copied into new manufacturing orders as their BoM's conversion minutes × this rate">
                        <field name="conversion_cost_rate"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
