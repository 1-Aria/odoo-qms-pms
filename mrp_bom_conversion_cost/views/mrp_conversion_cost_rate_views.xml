<odoo>
    <record id="mrp_conversion_cost_rate_view_list" model="ir.ui.view">
        <field name="name">mrp.conversion.cost.rate.list</field>
        <field name="model">mrp.conversion.cost.rate</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="date_from"/>
                <field name="rate"/>
                <field name="currency_id" optional="hide"/>
                <field name="state"
                    widget="badge"
                    decoration-success="state == 'approved'"
                    decoration-info="state == 'draft'"/>
                <field name="approved_by_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="mrp_conversion_cost_rate_view_form" model="ir.ui.view">
        <field name="name">mrp.conversion.cost.rate.form</field>
        <field name="model">mrp.conversion.cost.rate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve"
                        string="Approve"
                        type="object"
                        class="btn-primary"
                        groups="account.group_account_manager"
                        invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_productions"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-cogs"
                            groups="mrp.group_mrp_user">
                            <field name="production_count" widget="statinfo" string="Valued MOs"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"
                                groups="base.group_multi_company"
                                readonly="state != 'draft'"/>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <label for="rate"/>
                            <div class="o_row">
                                <field name="rate" readonly="state != 'draft'"/>
                                <field name="currency_id" nolabel="1" readonly="1" options="{'no_open': True}"/>
                            </div>
                        </group>
                        <group>
                            <field name="approved_by_id" invisible="state == 'draft'"/>
                            <field name="approved_date" invisible="state == 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="How the rate was set"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="mrp_conversion_cost_rate_view_search" model="ir.ui.view">
        <field name="name">mrp.conversion.cost.rate.search</field>
        <field name="model">mrp.conversion.cost.rate</field>
        <field name="arch" type="xml">
            <search>
                <field name="date_from"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mrp_conversion_cost_rate" model="ir.actions.act_window">
        <field name="name">Conversion Cost Rates</field>
        <field name="res_model">mrp.conversion.cost.rate</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mrp_conversion_cost_rate"
        parent="mrp.menu_mrp_configuration"
        action="action_mrp_conversion_cost_rate"
        groups="mrp.group_mrp_manager"
        sequence="60"/>

    <menuitem id="menu_account_conversion_cost_rate"
        parent="account.menu_finance_configuration"
        action="action_mrp_conversion_cost_rate"
        groups="account.group_account_manager"
        sequence="60"/>
</odoo>
