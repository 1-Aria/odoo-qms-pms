<odoo>
    <record id="resource_calendar_form" model="ir.ui.view">
        <field name="name">resource.calendar.form.inherit.hr_attendance_day</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hours_per_day']" position="after">
                <field name="paid_day_hours" widget="float_time" />
                <field name="night_start" widget="float_time" />
                <field name="night_end" widget="float_time" />
            </xpath>
        </field>
    </record>
</odoo>
