<odoo>

    <record id="view_mgmtsystem_action_form" model="ir.ui.view">
        <field name="name">mgmtsystem.action.form.qms.inspection</field>
        <field name="model">mgmtsystem.action</field>
        <field
            name="inherit_id"
            ref="mgmtsystem_action.view_mgmtsystem_action_form"
        />
        <field name="arch" type="xml">
            <!-- The field is the link: a Many2one on a form opens its record,
                 so no smart button is added on this side. The aggregate side
                 earns one, being a count of many actions that no field shows,
                 and that side is the inspection.

                 It also keeps this module out of the way of
                 maintenance_mgmtsystem_action: the action form has no button box
                 of its own, so two modules each creating one would give a form
                 two clusters of buttons. -->
            <field name="reference" position="after">
                <field
                    name="qms_inspection_id"
                    options="{'no_create': True}"
                    groups="quality_control_oca.group_quality_control_user"
                />
            </field>
        </field>
    </record>

</odoo>
