<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_vn_contract_wording_company_rule" model="ir.rule">
        <field name="name">Contract Wording: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_contract_wording"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="l10n_vn_contract_article_company_rule" model="ir.rule">
        <field name="name">Contract Article: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_contract_article"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="l10n_vn_contract_version_company_rule" model="ir.rule">
        <field name="name">Contract Version: multi-company</field>
        <field name="model_id" ref="model_l10n_vn_contract_version"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
