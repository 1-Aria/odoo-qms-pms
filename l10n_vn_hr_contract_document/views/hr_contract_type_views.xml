<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_type_view_form_l10n_vn_contract" model="ir.ui.view">
        <field name="name">hr.contract.type.form.l10n_vn_contract</field>
        <field name="model">hr.contract.type</field>
        <field name="inherit_id" ref="hr.hr_contract_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_vn_document_kind"/>
            </xpath>
        </field>
    </record>

    <record id="hr_contract_type_view_tree_l10n_vn_contract" model="ir.ui.view">
        <field name="name">hr.contract.type.list.l10n_vn_contract</field>
        <field name="model">hr.contract.type</field>
        <field name="inherit_id" ref="hr.hr_contract_type_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_vn_document_kind"/>
            </xpath>
        </field>
    </record>
</odoo>
