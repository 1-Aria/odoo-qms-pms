<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_view_form_l10n_vn_contract" model="ir.ui.view">
        <field name="name">res.company.form.l10n_vn_contract</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_registry']" position="after">
                <field name="country_code" invisible="1"/>
                <field name="l10n_vn_legal_rep_id" invisible="country_code != 'VN'"/>
                <field name="l10n_vn_legal_rep_title" invisible="country_code != 'VN'"/>
                <field name="l10n_vn_contract_code" invisible="country_code != 'VN'"/>
                <field name="l10n_vn_contract_approval" invisible="country_code != 'VN'"/>
            </xpath>
        </field>
    </record>
</odoo>
