<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_l10n_vn_contract" model="ir.ui.view">
        <field name="name">hr.employee.form.l10n_vn_contract</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="l10n_vn_payroll.hr_employee_view_form_l10n_vn_payroll"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_vn_personal_id']" position="after">
                <field name="l10n_vn_id_issue_date"/>
                <field name="l10n_vn_id_issue_place"/>
                <field name="l10n_vn_permanent_address"/>
            </xpath>
        </field>
    </record>
</odoo>
