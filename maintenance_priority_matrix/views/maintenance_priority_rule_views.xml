<odoo>

    <record id="maintenance_priority_rule_view_list" model="ir.ui.view">
        <field name="name">maintenance.priority.rule.list</field>
        <field name="model">maintenance.priority.rule</field>
        <field name="arch" type="xml">
            <!-- Editable, because the table is a grid someone fills in one
                 sitting. -->
            <list string="Priority Rules" editable="bottom">
                <field name="criticality" />
                <field name="urgency" />
                <field name="priority" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="maintenance_priority_rule_view_form" model="ir.ui.view">
        <field name="name">maintenance.priority.rule.form</field>
        <field name="model">maintenance.priority.rule</field>
        <field name="arch" type="xml">
            <form string="Priority Rule">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <field name="active" invisible="1" />
                    <group>
                        <group>
                            <field name="criticality" />
                            <field name="urgency" />
                        </group>
                        <group>
                            <field name="priority" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="maintenance_priority_rule_view_search" model="ir.ui.view">
        <field name="name">maintenance.priority.rule.search</field>
        <field name="model">maintenance.priority.rule</field>
        <field name="arch" type="xml">
            <search string="Priority Rules">
                <field name="criticality" />
                <field name="urgency" />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group name="group_by">
                    <filter
                        name="group_by_criticality"
                        string="Criticality"
                        context="{'group_by': 'criticality'}"
                    />
                    <filter
                        name="group_by_urgency"
                        string="Urgency"
                        context="{'group_by': 'urgency'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="maintenance_priority_rule_action" model="ir.actions.act_window">
        <field name="name">Priority Rules</field>
        <field name="res_model">maintenance.priority.rule</field>
        <field name="view_mode">list,form</field>
        <field
            name="search_view_id"
            ref="maintenance_priority_rule_view_search"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a priority rule</p>
            <p>
                One row per criticality and urgency. With no rules configured,
                no priority is suggested and a request's priority behaves as it
                does in core.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_maintenance_priority_rule"
        name="Priority Rules"
        parent="maintenance.menu_maintenance_configuration"
        action="maintenance_priority_rule_action"
        sequence="20"
    />

</odoo>
