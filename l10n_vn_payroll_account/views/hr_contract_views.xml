<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_contract_view_form_l10n_vn_payroll_account" model="ir.ui.view">
        <field name="name">hr.contract.form.l10n_vn_payroll_account</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="l10n_vn_payroll.hr_contract_view_form_l10n_vn_payroll" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_vn_pay_group']" position="after">
                <field name="l10n_vn_cost_group_id" options="{'no_create': True}" />
            </xpath>
        </field>
    </record>
</odoo>
