<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_l10n_vn_payroll_account" model="ir.ui.view">
        <field name="name">res.config.settings.form.l10n_vn_payroll_account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="payroll.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='payroll_accountant']" position="inside">
                <setting
                    id="l10n_vn_payroll_posting"
                    string="Post Payroll in Accounting"
                    help="Post each approved Vietnamese run and each payment from its payment list"
                >
                    <field name="l10n_vn_payroll_post" />
                    <div class="content-group" invisible="not l10n_vn_payroll_post">
                        <div class="row mt8">
                            <label for="l10n_vn_payroll_journal_id" class="col-lg-5 o_light_label" />
                            <field name="l10n_vn_payroll_journal_id" />
                        </div>
                        <div class="row">
                            <label for="l10n_vn_payroll_payable_account_id" class="col-lg-5 o_light_label" />
                            <field name="l10n_vn_payroll_payable_account_id" />
                        </div>
                        <div class="row">
                            <label for="l10n_vn_payroll_bank_journal_id" class="col-lg-5 o_light_label" />
                            <field name="l10n_vn_payroll_bank_journal_id" />
                        </div>
                        <div class="row">
                            <label for="l10n_vn_payroll_cash_journal_id" class="col-lg-5 o_light_label" />
                            <field name="l10n_vn_payroll_cash_journal_id" />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
