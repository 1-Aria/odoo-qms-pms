<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_vn_payroll_cost_group_view_list" model="ir.ui.view">
        <field name="name">l10n_vn.payroll.cost.group.list</field>
        <field name="model">l10n_vn.payroll.cost.group</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code" />
                <field name="name" />
                <field name="expense_account_id" options="{'no_create': True}" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="l10n_vn_payroll_cost_group_view_search" model="ir.ui.view">
        <field name="name">l10n_vn.payroll.cost.group.search</field>
        <field name="model">l10n_vn.payroll.cost.group</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="name" />
                <field name="expense_account_id" />
                <filter name="archived" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="l10n_vn_payroll_cost_group_action" model="ir.actions.act_window">
        <field name="name">Payroll Cost Groups</field>
        <field name="res_model">l10n_vn.payroll.cost.group</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
